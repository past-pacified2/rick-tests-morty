# Copy to .env for local development.
#
# Nothing here is secret. The Rick and Morty API is public and read-only, and
# anything in a VITE_-prefixed variable is compiled into the client bundle and
# therefore published. See docs/adr/0006-security.md.

VITE_API_BASE_URL=https://rickandmortyapi.com/api

# The site's own origin, no trailing slash. Substituted into index.html at build time
# for the canonical URL and the Open Graph / Twitter card tags — absolute URLs are
# required there, so this cannot be derived at runtime.
#
# In CI this comes from the PRODUCTION_URL repository variable. If it is unset the
# literal string "%VITE_SITE_URL%" ships in the HTML instead.
VITE_SITE_URL=http://localhost:5173
